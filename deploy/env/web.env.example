# Template for /etc/akasha/web.env (root:akasha, mode 0640).
# Loaded by the akasha-web systemd unit and by deploy/scripts/deploy.sh.
# Never commit real values.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Loopback only — Caddy is the only process that faces the internet.
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# ── SEO — read at BUILD time, so change → redeploy ───────────────────────────
# Canonical origin used in <link rel=canonical>, hreflang, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://akashainternational.com
# Leave false until this server actually serves akashainternational.com (after
# the WordPress cutover + 301 redirects). false = robots.txt Disallow + noindex.
SITE_INDEXABLE=false

# ── Backend phase — NOT read by the app yet ──────────────────────────────────
# Names reserved now so this file's layout is settled before the backend lands.
# The services behind them are already installed by deploy/SETUP.md §4–§6.
# DATABASE_URL=postgres://akasha_app:CHANGE_ME@127.0.0.1:5432/akasha_cms
# PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_BUCKET_MEDIA=akasha-media
# S3_BUCKET_DOCUMENTS=akasha-documents
# ASSET_BASE_URL=https://assets.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
