# /etc/caddy/Caddyfile
# SITE_DOMAIN and ACME_EMAIL come from /etc/caddy/caddy.env (see deploy/SETUP.md §7).
# HTTPS certificates are issued and renewed automatically by Let's Encrypt; that
# needs ports 80 and 443 reachable from the internet and the DNS record in place.

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Room for PDF uploads once the CMS admin exists.
	request_body {
		max_size 50MB
	}

	# Build assets carry a content hash in their name: cache for a year.
	handle_path /_next/static/* {
		root * /home/akasha/current/.next/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Images and downloads straight from disk — a 17 MB annual report has no
	# business streaming through the Node process. File names are not hashed,
	# so browsers revalidate daily (cheap 304s via ETag/Last-Modified).
	@public_files path /media/* /documents/*
	handle @public_files {
		root * /home/akasha/repo/public
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else, including /_next/image (the optimizer) and the locale
	# redirect on "/". Never cache HTML here: "/" answers differently per
	# cookie / Accept-Language.
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# ── Backend phase: public read access to object storage ──────────────────────
# Uncomment when public/media and public/documents move to SeaweedFS and
# ASSETS_DOMAIN is set in caddy.env. Only GET/HEAD reach SeaweedFS; writes stay
# on loopback, from the app.
