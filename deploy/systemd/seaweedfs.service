# /etc/systemd/system/seaweedfs.service
# S3-compatible object storage for the backend phase (buckets akasha-media and
# akasha-documents). Every port binds to loopback; public read access, when it is
# switched on, goes through Caddy (deploy/caddy/Caddyfile, assets block).
#   master 9333 · volume 8080 · filer 8888 · s3 8333 (+10000 for each gRPC port)
[Unit]
Description=SeaweedFS (single node: master + volume + filer + S3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
ExecStart=/usr/local/bin/weed server \
  -dir=/home/data/seaweedfs \
  -ip=127.0.0.1 \
  -ip.bind=127.0.0.1 \
  -master.volumeSizeLimitMB=1024 \
  -volume.max=0 \
  -filer \
  -s3 \
  -s3.port=8333 \
  -s3.config=/etc/seaweedfs/s3.json
Restart=always
RestartSec=5
LimitNOFILE=65536
MemoryMax=512M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/data/seaweedfs

[Install]
WantedBy=multi-user.target
